# ═══════════════════════════════════════════════════════
# ULITEC CRM — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores.
# ═══════════════════════════════════════════════════════

# Ambiente
ULITEC_AMBIENTE=DEV

# Senha inicial do usuário MASTER (criado automaticamente)
MASTER_PASSWORD=

# ═══════════════════════════════
# Provedor de IA
# ═══════════════════════════════
# Opções: groq | gemini | openai
IA_PROVIDER=groq

# ── Groq ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Gemini ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini